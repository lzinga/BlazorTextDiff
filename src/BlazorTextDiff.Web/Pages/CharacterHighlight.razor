@page "/character-highlight"

<PageTitle>Character highlights · BlazorTextDiff</PageTitle>

<header class="page-header">
    <p class="eyebrow">Look closer</p>
    <h1 tabindex="-1">Character highlights</h1>
    <p>See what changed inside a line, not just that the line changed. Character highlighting is included by default.</p>
</header>

<section class="example-section" aria-labelledby="small-edits-heading">
    <h2 id="small-edits-heading">Small edits within a word</h2>
    <p class="helper-text">Look for the added <code>d</code> in <code>completed</code> and the extra <code>p</code> removed from <code>repport</code>. The last line stays unchanged.</p>
    <TextDiff OldText="@typoOld" NewText="@typoNew" Class="demo-diff" id="word-highlights">
        <Header>
            <ComparisonHeader Stats="@context" />
        </Header>
    </TextDiff>
</section>

<section class="example-section" aria-labelledby="code-edits-heading">
    <h2 id="code-edits-heading">Names and values in code</h2>
    <p class="helper-text">Follow a renamed variable, a new value, and an updated filename. Stronger highlights isolate the edits inside each changed line.</p>
    <TextDiff OldText="@codeOld" NewText="@codeNew" Class="demo-diff" id="code-highlights">
        <Header>
            <ComparisonHeader Stats="@context" />
        </Header>
    </TextDiff>
</section>

<details id="highlight-guide" class="demo-disclosure">
    <summary>How to read the highlights <span class="summary-hint">Line → word → character</span></summary>
    <div class="disclosure-body">
        <dl class="note-list">
            <dt>Start with the row</dt>
            <dd>Amber marks a modified line, red a removed line, and green an added line. Unchanged lines stay uncolored.</dd>
            <dt>Look inside the word</dt>
            <dd>A partially changed word gets a soft highlight for context. A stronger highlight marks the characters that differ.</dd>
            <dt>Read a run, not a box per character</dt>
            <dd>Adjacent changed characters within a word share a highlight. A fully changed word uses the strong highlight without an extra word wrapper.</dd>
        </dl>
        <p class="helper-text">The header counts <em>lines</em>, not highlighted characters. One modified line can contain several edits.</p>
    </div>
</details>

<CodeExample Id="character-code" Title="Use character highlighting" Code="@Usage">
    <p class="helper-text">No extra flag is needed. Include the library stylesheet as shown in the <a href="">playground setup</a>. Colors and highlight shapes can be <a href="https://github.com/lzinga/BlazorTextDiff#customization">customized with CSS properties</a>.</p>
</CodeExample>

<p class="next-step">Next: <a href="async">load two versions from a remote source</a>, or <a href="">try your own texts in the playground</a>.</p>

@code {
    private const string typoOld = @"Export complete.
Save the repport.
Keep a local copy.";

    private const string typoNew = @"Export completed.
Save the report.
Keep a local copy.";

    private const string codeOld = @"var retryLimit = 3;
var fileName = ""draft.csv"";
var timeout = TimeSpan.FromSeconds(10);
await ExportAsync(fileName, retryLimit, timeout);";

    private const string codeNew = @"var maxRetries = 5;
var fileName = ""final.json"";
var timeout = TimeSpan.FromSeconds(30);
await ExportAsync(fileName, maxRetries, timeout);";

    private const string Usage = @"<TextDiff OldText=""@oldText"" NewText=""@newText"" />";
}
