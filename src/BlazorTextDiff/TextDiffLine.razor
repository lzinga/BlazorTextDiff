@using DiffPlex.DiffBuilder.Model;
@using System.Text;

@if (!string.IsNullOrEmpty(Model?.Text))
{
    @if (Model.Type == ChangeType.Unchanged)
    {
        @Model.Text
    }
    else if (Model.SubPieces is not null && Model.SubPieces.Count > 0)
    {
        @foreach (var word in GetWords())
        {
            @if (!word.HasChanges)
            {
                @word.Text
            }
            else if (word.IsFullyChanged)
            {
                @foreach (var run in word.Runs)
                {
                    <span class="@run.CssClass">@run.Text</span>
                }
            }
            else
            {
                <span class="@word.WordCss">@foreach (var run in word.Runs)
                    {
                        @if (run.IsChanged)
                        {<span class="@run.CssClass">@run.Text</span>}
                        else
                        {@run.Text}
                    }</span>
            }
        }
    }
    else
    {
        @Model.Text
    }
}

@code {
    [Parameter, EditorRequired] public DiffPiece Model { get; set; } = default!;

    private sealed record HighlightRun(string Text, ChangeType Type)
    {
        public bool IsChanged => Type != ChangeType.Unchanged;
        public string CssClass => $"{Type.ToString().ToLowerInvariant()}-character";
    }

    private sealed record WordGroup(
        string Text,
        List<HighlightRun> Runs,
        bool HasChanges,
        bool IsFullyChanged,
        string WordCss);

    private List<WordGroup> GetWords()
    {
        var words = new List<WordGroup>();
        var currentPieces = new List<DiffPiece>();
        var currentIsWhitespace = false;

        foreach (var sub in Model.SubPieces)
        {
            if (sub.Type == ChangeType.Imaginary) continue;
            if (string.IsNullOrEmpty(sub.Text)) continue;

            var isWhitespace = sub.Text.All(char.IsWhiteSpace);
            // Keep whitespace out of word wrappers, merging only like-styled whitespace.
            if (currentPieces.Count > 0
                && (currentIsWhitespace != isWhitespace
                    || (isWhitespace && currentPieces[^1].Type != sub.Type)))
            {
                words.Add(BuildWord(currentPieces));
                currentPieces.Clear();
            }

            currentPieces.Add(sub);
            currentIsWhitespace = isWhitespace;
        }

        if (currentPieces.Count > 0)
            words.Add(BuildWord(currentPieces));

        return words;
    }

    private static WordGroup BuildWord(List<DiffPiece> pieces)
    {
        var runs = new List<HighlightRun>();
        var runType = pieces[0].Type;
        var runText = new StringBuilder();
        foreach (var piece in pieces)
        {
            if (piece.Type != runType)
            {
                runs.Add(new HighlightRun(runText.ToString(), runType));
                runText.Clear();
                runType = piece.Type;
            }
            runText.Append(piece.Text);
        }
        runs.Add(new HighlightRun(runText.ToString(), runType));

        var text = string.Concat(runs.Select(run => run.Text));
        var changed = runs.Where(run => run.IsChanged).ToList();
        var hasChanges = changed.Count > 0;
        var isFullyChanged = changed.Count == runs.Count;
        var dominantType = changed.FirstOrDefault()?.Type ?? ChangeType.Unchanged;

        return new WordGroup(
            text,
            runs,
            hasChanges,
            isFullyChanged,
            $"{dominantType.ToString().ToLowerInvariant()}-word");
    }
}